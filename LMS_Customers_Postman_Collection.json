{
  "info": {
    "name": "LMS - Customers Module",
    "description": "API collection for managing Customers in the Enterprise LMS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "1. Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Kumar\",\n  \"fatherName\": \"Shyam Kumar\",\n  \"mobile\": \"9876543210\",\n  \"age\": 32,\n  \"gender\": \"Male\",\n  \"occupation\": \"Shop Owner\",\n  \"address\": \"Sector 10, Shop No 45\",\n  \"city\": \"Mumbai\",\n  \"area\": \"Vashi\",\n  \"idProofType\": \"Aadhar\",\n  \"idProofNumber\": \"123456789012\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/customers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ]
            }
          }
        },
        {
          "name": "2. List Customers (Default)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ]
            }
          }
        },
        {
          "name": "3. Get Customer by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "{{customer_id}}"
              ]
            }
          }
        },
        {
          "name": "4. Update Customer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"occupation\": \"Supermarket Owner\",\n  \"address\": \"Sector 12, Shop No 88\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "{{customer_id}}"
              ]
            }
          }
        },
        {
          "name": "5. Status Change",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INACTIVE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "{{customer_id}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "6. Pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers?page=2&limit=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "7. Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers?search=ramesh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "ramesh"
                }
              ]
            }
          }
        },
        {
          "name": "8. Filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers?city=Mumbai&status=ACTIVE",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "Mumbai"
                },
                {
                  "key": "status",
                  "value": "ACTIVE"
                }
              ]
            }
          }
        },
        {
          "name": "9. Unauthorized Access (Other Employee's Customer)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{wrong_employee_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "{{customer_id}}"
              ]
            },
            "description": "Simulates an employee trying to access a customer assigned to another employee. Returns a disguised 404 Not Found."
          }
        },
        {
          "name": "10. Invalid ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers/12345invalid",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "12345invalid"
              ]
            },
            "description": "Throws a CastError disguised as a standard 404 Customer Not Found."
          }
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "INSERT_VALID_JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "wrong_employee_token",
      "value": "INSERT_FOREIGN_EMPLOYEE_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "customer_id",
      "value": "INSERT_MONGO_ID_HERE",
      "type": "string"
    }
  ]
}
